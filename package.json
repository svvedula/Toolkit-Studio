{
  "name": "toolkit-studio",
  "productName": "Toolkit Studio",
  "version": "0.1.0",
  "description": "One prompt. Infinite tools. Turn a goal into a tool stack, a plan and copy-ready prompts.",
  "main": "electron/main.cjs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,app -c blue,magenta \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:web": "vite",
    "build": "vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "dist": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win nsis",
    "dist:mac": "vite build && electron-builder --mac dmg",
    "dist:linux": "vite build && electron-builder --linux AppImage",
    "seed:sql": "node scripts/make-seed.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.1.0",
    "@fontsource/ibm-plex-sans": "^5.1.0",
    "@splinetool/react-spline": "^4.1.0",
    "@splinetool/runtime": "^1.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "studio.toolkit.app",
    "productName": "Toolkit Studio",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["dist/**", "electron/**", "package.json"],
    "win": { "target": ["nsis"], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true },
    "mac": { "target": ["dmg"], "category": "public.app-category.productivity" },
    "linux": { "target": ["AppImage"], "category": "Utility" }
  }
}
